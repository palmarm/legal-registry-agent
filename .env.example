# Copy to .env and set a private local password before starting db.
# To generate and save it without printing it, run once from the repository root:
# python3 -c 'import pathlib,secrets; p=pathlib.Path(".env"); p.write_text(p.read_text().replace("POSTGRES_PASSWORD=\n", "POSTGRES_PASSWORD=" + secrets.token_hex(32) + "\n")); p.chmod(0o600)'
# The password initializes a new volume; changing it here does not reset an existing database user.
POSTGRES_DB=DATABASE_NAME
POSTGRES_USER=DATABASE_USER
POSTGRES_PASSWORD=DATABASE_PASSWORD
# Host connections use 127.0.0.1; port 5433 is reserved for LessonForge.
POSTGRES_PORT=5433
